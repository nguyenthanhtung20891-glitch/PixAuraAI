file(READ "${INPUT}" code)
foreach(pair IN ITEMS "NoContraction;5" "OpFMul;3" "OpFAdd;2" "OpTypeFloat;1")
    list(GET pair 0 pattern)
    list(GET pair 1 expected)
    string(REGEX MATCHALL "${pattern}" matches "${code}")
    list(LENGTH matches count)
    if(NOT count EQUAL expected)
        message(FATAL_ERROR "Reference shader ${pattern} count ${count}, expected ${expected}")
    endif()
endforeach()
if(code MATCHES "RelaxedPrecision|OpTypeFloat (16|64)|Fma|OpDot")
    message(FATAL_ERROR "Unsupported precision/contraction in reference shader")
endif()
