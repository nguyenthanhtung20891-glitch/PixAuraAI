include(${CMAKE_CURRENT_LIST_DIR}/sodium-sources.cmake)
file(READ "${CMAKE_CURRENT_LIST_DIR}/vendor/libsodium/provenance.json" sodium_pin)
string(JSON sodium_count LENGTH "${sodium_pin}" files)
math(EXPR sodium_last "${sodium_count}-1")
foreach(i RANGE ${sodium_last})
    string(JSON sodium_file MEMBER "${sodium_pin}" files ${i})
    string(JSON sodium_expected GET "${sodium_pin}" files "${sodium_file}")
    file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/vendor/libsodium/${sodium_file}" sodium_actual)
    if(NOT sodium_actual STREQUAL sodium_expected)
        message(FATAL_ERROR "Approved libsodium source integrity failure: ${sodium_file}")
    endif()
endforeach()
add_library(pixaura_sodium STATIC ${PIXAURA_SODIUM_SOURCES})
set_target_properties(pixaura_sodium PROPERTIES POSITION_INDEPENDENT_CODE ON C_VISIBILITY_PRESET hidden INTERPROCEDURAL_OPTIMIZATION OFF)
target_include_directories(pixaura_sodium PRIVATE packages/core/sodium-config packages/core/vendor/libsodium/src/libsodium/include packages/core/vendor/libsodium/src/libsodium/include/sodium)
target_compile_definitions(pixaura_sodium PRIVATE SODIUM_STATIC CONFIGURED=1)
target_compile_features(pixaura_sodium PRIVATE c_std_11)
if(PIXAURA_SANITIZERS)
    target_compile_options(pixaura_sodium PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(pixaura_sodium PRIVATE -fsanitize=address,undefined)
endif()
if(WIN32)
    target_link_libraries(pixaura_sodium PRIVATE advapi32)
endif()
target_link_libraries(pixaura_core PRIVATE pixaura_sodium)
target_include_directories(pixaura_core PRIVATE packages/core/sodium-config packages/core/vendor/libsodium/src/libsodium/include)
target_compile_definitions(pixaura_core PRIVATE SODIUM_STATIC)
