#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Source { uvec4 pixels[]; } source;
layout(set=0,binding=1,std430) writeonly buffer Result { uvec4 pixels[]; } result;
layout(push_constant) uniform Parameters { uint count; float gain; uint identity; } p;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=p.count) return;
    uvec4 v=source.pixels[i];
    if(p.identity==0) {
        precise vec3 rgb=uintBitsToFloat(v.xyz)*p.gain;
        v.xyz=floatBitsToUint(rgb);
    }
    result.pixels[i]=v;
}
