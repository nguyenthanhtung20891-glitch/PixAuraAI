      "before_body_lf": "    public func applyAutoFromHuman(_ review: AutoReview, onExecuting: () -> Void = {}) throws -> AgentReceipt {\n        var approval: AgentApproval?\n        gate.lock()\n        do {\n            try checked(closed ? 13 : review.owner != identity ? 9 : review.attempted || review.abandoned ? 15 : applyingReview != nil || cancellingReview ? 8 : 0, \"Auto Apply\")\n            idle.lock(); let busy = assistCalls != 0; idle.unlock()\n            try checked(busy ? 8 : 0, \"Auto Apply\")\n            try checked(inspectAutoLocked(review.proposal) == review.plan.canonicalBytes ? 0 : 9, \"Auto review\")\n            try checked(agentBytesLocked(2, review.plan.canonicalBytes) == review.plan.canonicalBytes ? 0 : 9, \"Auto review\")\n            try checked(attemptedAutoSerial == review.proposal.packet.request_serial ? 15 : 0, \"Auto Apply\")\n            review.attempted = true; attemptedAutoSerial = review.proposal.packet.request_serial\n            approval = try approveAgentPlanLocked(review.plan); applyingApproval = approval\n            applyingReview = review; idle.lock(); agentCalls += 1; idle.unlock()\n        } catch { gate.unlock(); throw error }\n        gate.unlock()\n        defer {\n            approval?.close()\n            gate.lock(); applyingApproval = nil; applyingReview = nil; gate.unlock()\n            idle.lock(); agentCalls -= 1; idle.broadcast(); idle.unlock()\n        }\n        onExecuting() // transport notification only; carries no approval issuer\n        let result = try executeAgentPlan(review.plan, approval: approval)\n        try checked(result.sourceRevision == review.sourceRevision ? 0 : 14, \"Auto receipt\")\n        return result\n    }\n",
      "approval": "CR18-02"
    },
    "platforms/android/bridge/src/main/kotlin/ai/pixaura/bridge/ManualEditor.kt#human-apply": {
      "before_sha256_lf": "5dfee7c6a7907e455e0bdfdde5346b3c2ed55faa72a8bc3e715a8e5598945313",
      "after_sha256_lf": "259dfab2d13101cb149fb26b18bfcf5e8b4460e76367d3b6b2966d632b393a3e",
      "before_body_lf": "    fun applyAutoFromHuman(review: AutoReview, onExecuting: () -> Unit = {}): AgentReceipt {\n        val approval = gate.withLock {\n            checked(if (closed) 13 else if (review.owner !== this) 9 else if (review.attempted || review.abandoned) 15\n                else if (applyingReview != null || cancellingReview || assistCalls != 0) 8 else 0, \"Auto Apply\")\n            checked(if (inspectAuto(review.proposal).contentEquals(review.plan.canonicalBytes())) 0 else 9, \"Auto review\")\n            checked(if (validateAgentPlan(review.plan.canonicalBytes()).canonicalBytes().contentEquals(review.plan.canonicalBytes())) 0 else 9, \"Auto review\")\n            checked(if (attemptedAutoSerial == review.proposal.packet.duplicate().order(ByteOrder.nativeOrder()).getLong(56)) 15 else 0, \"Auto Apply\")\n            review.attempted = true; attemptedAutoSerial = review.proposal.packet.duplicate().order(ByteOrder.nativeOrder()).getLong(56)\n            val issued = approveAgentPlanFromHuman(review.plan); applyingApproval = issued\n            applyingReview = review; agentCalls++ // includes approval cleanup and callback; close must join all of it\n            issued\n        }\n        try {\n            onExecuting() // notification only, never an approval issuer\n            val receipt = executeAgentPlan(review.plan, approval)\n            checked(if (receipt.sourceRevision == review.sourceRevision) 0 else 14, \"Auto receipt\")\n            return receipt\n        } finally { gate.withLock {\n            try { approval.close() } finally {\n                applyingApproval = null; applyingReview = null; agentCalls--; idle.signalAll()\n            }\n        } }\n    }\n",
      "approval": "CR18-02"
    }
